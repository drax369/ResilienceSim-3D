# ResilienceSim 3D — Environment Template Example
# Copy this file to .env if you need to override default host/port bindings.

# Backend Configuration (Optional - defaults to 127.0.0.1:8000)
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Configuration (Optional - defaults to Vite port 5173 with proxy to 127.0.0.1:8000)
VITE_PORT=5173
